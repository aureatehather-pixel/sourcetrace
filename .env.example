# Copy to .env for local development. .env is git-ignored; never commit real credentials.

# One of: local | test | production
ENVIRONMENT=local

# SQLAlchemy async URL. Driver must be psycopg (v3).
# Matches the credentials in compose.yaml for local development only.
DATABASE_URL=postgresql+psycopg://pie:pie_local_dev@localhost:5433/pie

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Extraction (M2) ---------------------------------------------------------
# Which vendor routine extraction goes to: anthropic | deepseek.
# Named explicitly rather than inferred from whichever key is set.
EXTRACTION_PROVIDER=anthropic

# Leave the selected provider's key EMPTY to use the deterministic fake provider
# (fine for local work). The selected provider's key is REQUIRED when
# ENVIRONMENT=production - the app refuses to start without it.
# Never commit a real key; this file is an example only.
ANTHROPIC_API_KEY=

# Only read when EXTRACTION_PROVIDER=deepseek.
DEEPSEEK_API_KEY=

# Defaults shown. Override only with a reason.
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_TIMEOUT_SECONDS=90
EXTRACTION_MAX_RETRIES=2

# Only read when EXTRACTION_PROVIDER=deepseek. Defaults shown.
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Send the wire schema as a json_schema response format rather than json_object.
DEEPSEEK_USE_JSON_SCHEMA=true
